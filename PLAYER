      });

      document.querySelectorAll('.toggle-status-btn').forEach(b => {
        b.addEventListener('click', () => {
          const p = allPlayersList.find(pl => pl.id === b.dataset.id);
          if (p) {
            p.status = p.status === 'Active' ? 'Suspended' : 'Active';
            renderAdminPlayers(search);
            showToast(`Updated status for ${p.name} to ${p.status}`, 'info');
          }
        });
      });
    }

    function setupAdminEventListeners() {
      // Role Switcher
      const switchRolePlayerBtn = document.getElementById('switchRolePlayerBtn');
      const switchRoleAdminBtn = document.getElementById('switchRoleAdminBtn');
      const playerView = document.getElementById('playerAppView');
      const adminView = document.getElementById('adminPortalView');

      switchRolePlayerBtn.addEventListener('click', () => {
        activeRole = 'player';
        switchRolePlayerBtn.className = 'px-3.5 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-black shadow transition flex items-center gap-1.5';
        switchRoleAdminBtn.className = 'px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition flex items-center gap-1.5';
        playerView.classList.remove('hidden');
        adminView.classList.add('hidden');
        updateUI();
      });

      switchRoleAdminBtn.addEventListener('click', () => {
        activeRole = 'admin';
        switchRoleAdminBtn.className = 'px-3.5 py-1.5 rounded-lg bg-red-600 text-white font-black shadow transition flex items-center gap-1.5';
        switchRolePlayerBtn.className = 'px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition flex items-center gap-1.5';
        adminView.classList.remove('hidden');
        playerView.classList.add('hidden');
        updateAdminGateUI();
      });

      document.getElementById('adminQuickSwitchToPlayer').addEventListener('click', () => {
        switchRolePlayerBtn.click();
      });

      // ADMIN AUTH GATE CONTROLS
      const adminGateLoginBtn = document.getElementById('adminGateTabLoginBtn');
      const adminGateRegBtn = document.getElementById('adminGateTabRegisterBtn');
      const adminGateLoginForm = document.getElementById('adminGateLoginForm');
      const adminGateRegForm = document.getElementById('adminGateRegisterForm');

      adminGateLoginBtn.addEventListener('click', () => {
        adminGateLoginBtn.className = 'flex-1 py-2.5 text-amber-400 border-b-2 border-amber-500';
        adminGateRegBtn.className = 'flex-1 py-2.5 text-slate-400 hover:text-white border-b-2 border-transparent';
        adminGateLoginForm.classList.remove('hidden');
        adminGateRegForm.classList.add('hidden');
      });

      adminGateRegBtn.addEventListener('click', () => {
        adminGateRegBtn.className = 'flex-1 py-2.5 text-amber-400 border-b-2 border-amber-500';
        adminGateLoginBtn.className = 'flex-1 py-2.5 text-slate-400 hover:text-white border-b-2 border-transparent';
        adminGateRegForm.classList.remove('hidden');
        adminGateLoginForm.classList.add('hidden');
      });

      document.getElementById('submitAdminGateLoginBtn').addEventListener('click', () => {
        const id = document.getElementById('adminGateLoginIdInput').value.trim();
        const pin = document.getElementById('adminGateLoginPinInput').value.trim();
        if (id !== 'admin' || pin !== 'admin123') {
          showToast('Invalid Admin Credentials! Use ID: admin / PIN: admin123', 'error');
          return;
        }
        adminAuth.isLoggedIn = true;
        updateAdminGateUI();
        showToast('Admin access granted. Welcome to Master Control Room.', 'success');
      });

      document.getElementById('submitAdminGateRegisterBtn').addEventListener('click', () => {
        const sec = document.getElementById('adminGateRegSecretInput').value.trim();
        if (sec !== 'MANIPUR2026') {
          showToast('Invalid Master Secret Key! Must be MANIPUR2026', 'error');
          return;
        }
        adminAuth.isLoggedIn = true;
        updateAdminGateUI();
        showToast('New Admin account registered & authenticated!', 'success');
      });

      document.getElementById('adminLogoutBtn').addEventListener('click', () => {
        adminAuth.isLoggedIn = false;
        updateAdminGateUI();
        showToast('Admin logged out successfully.', 'info');
      });

      // 3 Tables for Admin
      document.getElementById('adminTableSelectBtn1').addEventListener('click', () => switchTable(1));
      document.getElementById('adminTableSelectBtn2').addEventListener('click', () => switchTable(2));
      document.getElementById('adminTableSelectBtn3').addEventListener('click', () => switchTable(3));

      // Admin Seat Fill / Toggle
      document.getElementById('adminSeatFillBtn').addEventListener('click', () => {
        document.getElementById('autoSeatPlayersBtn').click();
      });

      // Admin Navigation Tabs
      const tabFinBtn = document.getElementById('adminTabFinancesBtn');
      const tabGameBtn = document.getElementById('adminTabGameControlBtn');
      const tabPlayBtn = document.getElementById('adminTabPlayersBtn');
      const tabSetBtn = document.getElementById('adminTabSettingsBtn');

      const contentFin = document.getElementById('adminContentFinances');
      const contentGame = document.getElementById('adminContentGameControl');
      const contentPlay = document.getElementById('adminContentPlayers');
      const contentSet = document.getElementById('adminContentSettings');

      function resetAdminTabs() {
        [tabFinBtn, tabGameBtn, tabPlayBtn, tabSetBtn].forEach(t => {
          t.className = 'flex-1 py-3 px-4 rounded-xl text-slate-400 hover:text-white transition flex items-center justify-center gap-2';
        });
        [contentFin, contentGame, contentPlay, contentSet].forEach(c => c.classList.add('hidden'));
      }

      tabFinBtn.addEventListener('click', () => {
        resetAdminTabs();
        tabFinBtn.className = 'flex-1 py-3 px-4 rounded-xl bg-amber-500 text-slate-950 shadow transition flex items-center justify-center gap-2';
        contentFin.classList.remove('hidden');
        updateAdminFinancesUI();
      });

      tabGameBtn.addEventListener('click', () => {
        resetAdminTabs();
        tabGameBtn.className = 'flex-1 py-3 px-4 rounded-xl bg-amber-500 text-slate-950 shadow transition flex items-center justify-center gap-2';
        contentGame.classList.remove('hidden');
      });

      tabPlayBtn.addEventListener('click', () => {
        resetAdminTabs();
        tabPlayBtn.className = 'flex-1 py-3 px-4 rounded-xl bg-amber-500 text-slate-950 shadow transition flex items-center justify-center gap-2';
        contentPlay.classList.remove('hidden');
        renderAdminPlayers();
      });

      tabSetBtn.addEventListener('click', () => {
        resetAdminTabs();
        tabSetBtn.className = 'flex-1 py-3 px-4 rounded-xl bg-amber-500 text-slate-950 shadow transition flex items-center justify-center gap-2';
        contentSet.classList.remove('hidden');
      });

      // Admin Game Controls
      document.getElementById('adminForceRollBtn').addEventListener('click', () => {
        const currentTable = TABLES_CONFIG.find(t => t.id === currentTableId);
        if (currentTable.seated.length < 6) {
          showToast('Cannot force roll: 6 players mandatory! Seat 6 players first.', 'error');
          return;
        }
        if (currentPhase === 'BETTING') {
          timerValue = 0;
          showToast('⚡ Forced instant dice roll!', 'warning');
        } else {
          showToast('Round is already in roll/result phase.', 'info');
        }
      });

      document.getElementById('adminPauseResumeBtn').addEventListener('click', () => {
        adminTimerPaused = !adminTimerPaused;
        document.getElementById('adminPauseBtnText').textContent = adminTimerPaused ? 'Resume Timer' : 'Pause Timer';
        showToast(adminTimerPaused ? 'Game clock paused by Admin' : 'Game clock resumed', 'info');
      });

      document.getElementById('adminResetPoolBtn').addEventListener('click', () => {
        roomPool = 40000;
        updateUI();
        document.getElementById('adminCurrentPoolDisplay').textContent = roomPool.toLocaleString('en-IN');
        showToast('Table pool reset to default base.', 'info');
      });

      const rngModeSelect = document.getElementById('adminRngModeSelect');
      const manualDiceContainer = document.getElementById('adminManualDiceContainer');
      rngModeSelect.addEventListener('change', () => {
        adminRngMode = rngModeSelect.value;
        if (adminRngMode === 'manual') {
          manualDiceContainer.classList.remove('hidden');
          document.getElementById('adminCurrentRngModeText').textContent = 'Manual Admin Preset';
          showToast('Manual Dice Outcome Override activated.', 'warning');
        } else {
          manualDiceContainer.classList.add('hidden');
          document.getElementById('adminCurrentRngModeText').textContent = 'Fair Automatic RNG';
          showToast('Automatic Fair RNG restored.', 'success');
        }
      });

      document.getElementById('adminPlayerSearchInput').addEventListener('input', (e) => {
        renderAdminPlayers(e.target.value.trim());
      });

      document.getElementById('adminCancelAdjustBtn').addEventListener('click', () => {
        document.getElementById('adminAdjustModal').classList.add('hidden');
        selectedPlayerToAdjust = null;
      });

      document.getElementById('adminConfirmAdjustBtn').addEventListener('click', () => {
        if (!selectedPlayerToAdjust) return;
        const amt = parseInt(document.getElementById('adminAdjustAmountInput').value, 10) || 0;
        const type = document.getElementById('adminAdjustTypeSelect').value;

        if (amt <= 0) {
          showToast('Please enter an amount greater than 0', 'error');
          return;
        }

        if (type === 'add') {
          selectedPlayerToAdjust.balance += amt;
          if (selectedPlayerToAdjust.mobile === currentUser.mobile) {
            currentUser.balance += amt;
            saveUserState();
            updateUI();
          }
          showToast(`Added ₹${amt} chips to ${selectedPlayerToAdjust.name}`, 'success');
        } else {
          selectedPlayerToAdjust.balance = Math.max(0, selectedPlayerToAdjust.balance - amt);
          if (selectedPlayerToAdjust.mobile === currentUser.mobile) {
            currentUser.balance = Math.max(0, currentUser.balance - amt);
            saveUserState();
            updateUI();
          }
          showToast(`Deducted ₹${amt} chips from ${selectedPlayerToAdjust.name}`, 'info');
        }

        document.getElementById('adminAdjustModal').classList.add('hidden');
        renderAdminPlayers();
      });

      document.getElementById('adminBroadcastForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const text = document.getElementById('adminBroadcastInput').value.trim();
        if (!text) return;

        const banner = document.getElementById('playerBroadcastBanner');
        const bannerText = document.getElementById('playerBroadcastText');
        bannerText.textContent = text;
        banner.classList.remove('hidden');

        addChatMessage('📢 ADMIN BROADCAST', text, false);
        showToast('Announcement broadcasted to all active players!', 'success');
        broadcastStateChange();
      });

      document.getElementById('dismissBroadcastBtn').addEventListener('click', () => {
        document.getElementById('playerBroadcastBanner').classList.add('hidden');
      });

      document.getElementById('adminSaveSettingsBtn').addEventListener('click', () => {
        showToast('Game & table limits saved successfully!', 'success');
      });

      document.getElementById('adminRefreshFinancesBtn').addEventListener('click', () => {
        updateAdminFinancesUI();
        showToast('Financial queue refreshed', 'info');
      });

      document.getElementById('downloadPlayerAppBtn').addEventListener('click', () => {
        triggerStandaloneDownload('manipur_lagao_player.html');
      });

      document.getElementById('downloadAdminAppBtn').addEventListener('click', () => {
        triggerStandaloneDownload('manipur_lagao_admin.html');
      });

      document.getElementById('downloadSuiteZipBtn').addEventListener('click', () => {
        triggerStandaloneDownload('lagao_khaoba_suite.zip');
      });
    }

    function updateAdminGateUI() {
      const gate = document.getElementById('adminAuthGate');
      const dash = document.getElementById('adminDashboardView');
      if (adminAuth.isLoggedIn) {
        gate.classList.add('hidden');
        dash.classList.remove('hidden');
        updateAdminFinancesUI();
        renderAdminPlayers();
      } else {
        gate.classList.remove('hidden');
        dash.classList.add('hidden');
      }
    }

    function triggerStandaloneDownload(filename) {
      const a = document.createElement('a');
      a.href = filename;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast(`Initiating download for ${filename} 📦`, 'success');
    }

    // MULTI-TAB / REAL-TIME STORAGE EVENT LISTENER
    window.addEventListener('storage', (e) => {
      if (e.key === 'manipur_lagao_sync' && e.newValue) {
        try {
          const sync = JSON.parse(e.newValue);
          if (sync.currentUser) currentUser = Object.assign(currentUser, sync.currentUser);
          if (sync.pendingRecharges) pendingRecharges = sync.pendingRecharges;
          if (sync.pendingWithdrawals) pendingWithdrawals = sync.pendingWithdrawals;
          if (sync.roomPool) roomPool = sync.roomPool;
          updateUI();
          updateAdminFinancesUI();
        } catch (err) {
          console.warn('Sync listener err', err);
        }
      }
    });

    // Boot the application
    window.onload = function() {
      loadSavedState();
      renderBettingBoard();
      renderDiceGrid();
      renderRoadmapAndStats();
      renderLeaderboard();
      setupEventListeners();
      setupAdminEventListeners();
      updateAdminFinancesUI();
      seedInitialChat();
      updateUI();
      updateAdminGateUI();

      // Start core live countdown loop
      startBettingPhase();
      timerInterval = setInterval(runTimerTick, 1000);
    };

  </script>
</body>
</html>
