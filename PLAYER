    function renderPassbook(filter = 'all') {
      const tbody = document.getElementById('passbookTableBody');
      tbody.innerHTML = '';

      const filtered = transactions.filter(t => {
        if (filter === 'all') return true;
        return t.type === filter;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-500">No transactions recorded in this category.</td></tr>`;
        return;
      }

      filtered.forEach(tx => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/40';
        
        let amountClass = 'text-emerald-400';
        let prefix = '+';
        if (tx.type === 'withdrawal') {
          amountClass = 'text-amber-400';
          prefix = '-';
        }

        tr.innerHTML = `
          <td class="p-2.5 text-slate-400">${tx.date}</td>
          <td class="p-2.5 font-semibold text-white">${tx.desc}</td>
          <td class="p-2.5 font-mono text-[10px] text-slate-500">${tx.id}</td>
          <td class="p-2.5 text-right font-bold ${amountClass}">${prefix}₹${tx.amount.toLocaleString('en-IN')}</td>
          <td class="p-2.5 text-right"><span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/20 text-emerald-300">${tx.status}</span></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openModal(modalId) {
      document.querySelectorAll('#rechargeModal, #withdrawModal, #authModal, #rulesModal, #walletPassbookModal').forEach(m => m.classList.add('hidden'));
      const target = document.getElementById(modalId);
      if (target) {
        target.classList.remove('hidden');
        if (modalId === 'walletPassbookModal') renderPassbook('all');
      }
    }

    function closeModal(modalId) {
      const target = document.getElementById(modalId);
      if (target) target.classList.add('hidden');
    }

    function setupEventListeners() {
      // Sound Toggle
      document.getElementById('soundToggleBtn').addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        document.getElementById('soundIcon').textContent = soundEnabled ? '🔊' : '🔇';
        showToast(soundEnabled ? 'Game sound effects enabled' : 'Game sound muted', 'info');
      });

      // Download HTML
      document.getElementById('downloadHtmlBtn').addEventListener('click', () => {
        try {
          const docType = '<!DOCTYPE html>\n';
          const fullHtml = docType + document.documentElement.outerHTML;
          const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'manipur_lagao_khaoba.html';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Standalone manipur_lagao_khaoba.html downloaded! 💾', 'success');
        } catch (e) {
          showToast('Download initiated. You can save this page directly.', 'info');
        }
      });

      document.getElementById('footerDownloadHtmlLink').addEventListener('click', () => {
        document.getElementById('downloadHtmlBtn').click();
      });

      // Chip Selector
      document.querySelectorAll('.chip-selector').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.chip-selector').forEach(b => b.classList.remove('chip-selected'));
          btn.classList.add('chip-selected');
          selectedChip = parseInt(btn.dataset.chip, 10);
          updateUI();
          playSound('chip');
        });
      });

      // Clear Bets
      document.getElementById('clearBetsBtn').addEventListener('click', () => {
        if (currentPhase !== 'BETTING') return;
        const totalRefund = Object.values(currentBets).reduce((a, b) => a + b, 0);
        if (totalRefund > 0) {
          currentUser.balance += totalRefund;
          roomPool -= totalRefund;
          currentBets = { flag: 0, crown: 0, diamond: 0, heart: 0, club: 0, spade: 0 };
          updateUI();
          saveUserState();
          showToast(`Cleared bets and refunded ₹${totalRefund}`, 'info');
        }
      });

      // Double Bets
      document.getElementById('doubleBetsBtn').addEventListener('click', () => {
        if (currentPhase !== 'BETTING') return;
        const additionalRequired = Object.values(currentBets).reduce((a, b) => a + b, 0);
        if (additionalRequired === 0) {
          showToast('Place at least one bet first to double!', 'warning');
          return;
        }
        if (currentUser.balance < additionalRequired) {
          showToast('Insufficient balance to double your bets!', 'error');
          openModal('rechargeModal');
          return;
        }
        currentUser.balance -= additionalRequired;
        roomPool += additionalRequired;
        SYMBOLS.forEach(s => currentBets[s.id] *= 2);
        playSound('chip');
        updateUI();
        saveUserState();
        showToast(`Doubled all bets! Total stake: ₹${additionalRequired * 2}`, 'success');
      });

      // Repeat Bet
      document.getElementById('rebetBtn').addEventListener('click', () => {
        if (currentPhase !== 'BETTING') return;
        const prevTotal = Object.values(previousBets).reduce((a, b) => a + b, 0);
        if (prevTotal === 0) {
          showToast('No previous bet round to repeat!', 'warning');
          return;
        }
        if (currentUser.balance < prevTotal) {
          showToast('Insufficient balance to repeat previous bets!', 'error');
          openModal('rechargeModal');
          return;
        }
        currentUser.balance -= prevTotal;
        roomPool += prevTotal;
        currentBets = { ...previousBets };
        playSound('chip');
        updateUI();
        saveUserState();
        showToast(`Repeated previous round bets (₹${prevTotal})`, 'success');
      });

      // Modals
      document.getElementById('openRulesBtn').addEventListener('click', () => openModal('rulesModal'));
      document.getElementById('closeRulesModalBtn').addEventListener('click', () => closeModal('rulesModal'));
      document.getElementById('openRechargeModalBtn').addEventListener('click', () => openModal('rechargeModal'));
      document.getElementById('closeRechargeModalBtn').addEventListener('click', () => closeModal('rechargeModal'));
      document.getElementById('openWithdrawModalBtn').addEventListener('click', () => openModal('withdrawModal'));
      document.getElementById('closeWithdrawModalBtn').addEventListener('click', () => closeModal('withdrawModal'));
      document.getElementById('userProfileBtn').addEventListener('click', () => {
        openModal('authModal');
        document.getElementById('authTabProfileBtn').click();
      });
      document.getElementById('closeAuthModalBtn').addEventListener('click', () => closeModal('authModal'));
      document.getElementById('closePassbookModalBtn').addEventListener('click', () => closeModal('walletPassbookModal'));

      // Footer
      document.getElementById('footerRulesLink').addEventListener('click', () => openModal('rulesModal'));
      document.getElementById('footerWalletLink').addEventListener('click', () => openModal('walletPassbookModal'));
      document.getElementById('footerFairRngLink').addEventListener('click', () => openModal('rulesModal'));
      document.getElementById('footerResponsibleLink').addEventListener('click', () => {
        showToast('Play responsibly! Manipur Lagao Khaoba is strictly for entertainment & cultural recreation.', 'info');
      });

      // Player Logout
      document.getElementById('playerLogoutBtn').addEventListener('click', () => {
        currentUser.isLoggedIn = false;
        saveUserState();
        updateUI();
        showToast('You have logged out from the Player App.', 'info');
      });

      // 3 TABLES BUTTONS (PLAYER VIEW)
      document.getElementById('tableSelectBtn1').addEventListener('click', () => switchTable(1));
      document.getElementById('tableSelectBtn2').addEventListener('click', () => switchTable(2));
      document.getElementById('tableSelectBtn3').addEventListener('click', () => switchTable(3));

      // 6 PLAYERS SEAT CONTROLS
      document.getElementById('toggleSitPlayerBtn').addEventListener('click', () => {
        const currentTable = TABLES_CONFIG.find(t => t.id === currentTableId);
        if (isUserSeated) {
          // Leave seat
          const idx = currentTable.seated.findIndex(s => s && s.isUser);
          if (idx !== -1) currentTable.seated.splice(idx, 1);
          isUserSeated = false;
          showToast('You left your seat at the table.', 'info');
        } else {
          // Take seat
          if (currentTable.seated.length >= 6) {
            showToast('All 6 seats at this table are currently full!', 'warning');
            return;
          }
          currentTable.seated.push({
            seat: currentTable.seated.length + 1,
            name: `${currentUser.name} (You)`,
            district: currentUser.district,
            isUser: true
          });
          isUserSeated = true;
          showToast('You took a seat at the table!', 'success');
        }
        renderTableSeatingRoster();
        broadcastStateChange();
      });

      document.getElementById('autoSeatPlayersBtn').addEventListener('click', () => {
        const currentTable = TABLES_CONFIG.find(t => t.id === currentTableId);
        const count = currentTable.seated.length;
        if (count < 6) {
          // Fill to 6
          const needed = 6 - count;
          for (let i = 0; i < needed; i++) {
            currentTable.seated.push({
              seat: currentTable.seated.length + 1,
              name: `Table Player #${currentTable.seated.length + 1}`,
              district: currentUser.district,
              isUser: false
            });
          }
          showToast('Seated waiting players. All 6 seats filled - Round can now begin!', 'success');
        } else {
          // Clear extra seats to demonstrate waiting state
          currentTable.seated = [
            { seat: 1, name: `${currentUser.name} (You)`, district: currentUser.district, isUser: true },
            { seat: 2, name: 'Table Player #2', district: currentUser.district, isUser: false },
            { seat: 3, name: 'Table Player #3', district: currentUser.district, isUser: false },
            { seat: 4, name: 'Table Player #4', district: currentUser.district, isUser: false }
          ];
          showToast('Emptied 2 seats: Round paused waiting for 6 mandatory players.', 'info');
        }
        renderTableSeatingRoster();
        broadcastStateChange();
      });

      // PLAYER AUTH GATE
      const pGateLoginBtn = document.getElementById('playerGateTabLoginBtn');
      const pGateRegBtn = document.getElementById('playerGateTabRegisterBtn');
      const pGateLoginForm = document.getElementById('playerGateLoginForm');
      const pGateRegForm = document.getElementById('playerGateRegisterForm');

      pGateLoginBtn.addEventListener('click', () => {
        pGateLoginBtn.className = 'flex-1 py-2.5 text-amber-400 border-b-2 border-amber-500';
        pGateRegBtn.className = 'flex-1 py-2.5 text-slate-400 hover:text-white border-b-2 border-transparent';
        pGateLoginForm.classList.remove('hidden');
        pGateRegForm.classList.add('hidden');
      });

      pGateRegBtn.addEventListener('click', () => {
        pGateRegBtn.className = 'flex-1 py-2.5 text-amber-400 border-b-2 border-amber-500';
        pGateLoginBtn.className = 'flex-1 py-2.5 text-slate-400 hover:text-white border-b-2 border-transparent';
        pGateRegForm.classList.remove('hidden');
        pGateLoginForm.classList.add('hidden');
      });

      document.getElementById('submitGateLoginBtn').addEventListener('click', () => {
        const mob = document.getElementById('gateLoginMobileInput').value.trim();
        if (mob.length !== 10) {
