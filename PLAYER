        extend: {
          colors: {
            manipur: {
              gold: '#F59E0B',
              ruby: '#DC2626',
              emerald: '#059669',
              royal: '#1E1B4B',
              dark: '#0F172A',
              card: '#1E293B',
              accent: '#D97706',
              border: '#334155'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          animation: {
            'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'shake': 'shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite',
            'bounce-short': 'bounce 0.6s ease infinite',
          },
          keyframes: {
            shake: {
              '10%, 90%': { transform: 'translate3d(-2px, 0, 0) rotate(-2deg)' },
              '20%, 80%': { transform: 'translate3d(3px, 0, 0) rotate(3deg)' },
              '30%, 50%, 70%': { transform: 'translate3d(-4px, 0, 0) rotate(-4deg)' },
              '40%, 60%': { transform: 'translate3d(4px, 0, 0) rotate(4deg)' }
            }
