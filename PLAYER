      document.getElementById('phaseBadge').textContent = 'ROLLING DICE';
      document.getElementById('phaseBadge').className = 'text-amber-400 font-bold uppercase text-[11px] tracking-wide animate-pulse';

      document.getElementById('shakerCup').classList.add('shaker-active');
      document.getElementById('cupStatusText').innerHTML = '<span class="text-amber-400 font-bold animate-pulse">Shaking 6 Dice...</span>';

      let rollInterval = setInterval(() => {
        currentDiceResult = Array.from({ length: 6 }, () => {
          const rand = Math.floor(Math.random() * SYMBOLS.length);
          return SYMBOLS[rand].id;
        });
        renderDiceGrid(false);
      }, 120);

      setTimeout(() => {
        clearInterval(rollInterval);
        if (adminRngMode === 'manual') {
          currentDiceResult = [
            document.getElementById('adminDie1Select').value,
            document.getElementById('adminDie2Select').value,
            document.getElementById('adminDie3Select').value,
            document.getElementById('adminDie4Select').value,
            document.getElementById('adminDie5Select').value,
            document.getElementById('adminDie6Select').value
          ];
        } else {
          currentDiceResult = Array.from({ length: 6 }, () => {
            const rand = Math.floor(Math.random() * SYMBOLS.length);
            return SYMBOLS[rand].id;
          });
        }
        document.getElementById('shakerCup').classList.remove('shaker-active');
        startResultPhase();
      }, 4000);
    }

    function startResultPhase() {
      currentPhase = 'RESULT';
      renderDiceGrid(true);

      document.getElementById('phaseTitle').textContent = 'Round Result & Payouts';
      document.getElementById('phaseSubtitle').textContent = 'Revealing winning symbols and crediting multipliers!';
      document.getElementById('phaseBadge').textContent = 'PAYOUTS';
      document.getElementById('phaseBadge').className = 'text-cyan-400 font-bold uppercase text-[11px] tracking-wide';
      document.getElementById('cupStatusText').innerHTML = '<span>Dice Revealed</span>';

      const counts = {};
      SYMBOLS.forEach(s => counts[s.id] = 0);
      currentDiceResult.forEach(s => counts[s]++);

      let totalWinnings = 0;
      let winningSymbolsList = [];

      SYMBOLS.forEach(sym => {
        const occurrences = counts[sym.id];
        const betAmount = currentBets[sym.id] || 0;
        if (occurrences > 0) {
          winningSymbolsList.push(`${sym.icon} ${sym.name} (${occurrences}x)`);
        }
        if (betAmount > 0 && occurrences > 0) {
          const multiplier = occurrences;
          const profit = betAmount * multiplier;
          totalWinnings += (betAmount + profit);
        }
      });

      const totalBetThisRound = Object.values(currentBets).reduce((a, b) => a + b, 0);
      currentUser.roundsPlayed++;
      currentUser.totalWagered += totalBetThisRound;

      if (totalWinnings > 0) {
        currentUser.balance += totalWinnings;
        currentUser.roundsWon++;
        currentUser.totalWon += totalWinnings;
        playSound('win');

        transactions.unshift({
          id: `TXN-${Math.floor(100000 + Math.random() * 900000)}`,
          type: 'game',
          amount: totalWinnings,
          desc: `Round #${roundCount} Win (${winningSymbolsList.slice(0, 2).join(', ')})`,
          date: 'Just now',
          status: 'Credited'
        });

        document.getElementById('resultCelebrationIcon').textContent = '🎉';
        document.getElementById('resultCelebrationTitle').textContent = 'CONGRATULATIONS!';
        document.getElementById('resultCelebrationTitle').className = 'text-xl sm:text-2xl font-black text-amber-400';
        document.getElementById('resultCelebrationSummary').textContent = `Winning symbols: ${winningSymbolsList.join(', ')}`;
        document.getElementById('resultCelebrationPayout').innerHTML = `You won <span class="text-2xl font-black text-emerald-400">₹${totalWinnings}</span>!`;
        document.getElementById('resultCelebrationBanner').classList.remove('hidden');

        showToast(`You won ₹${totalWinnings} this round! 🏆`, 'success');
      } else if (totalBetThisRound > 0) {
        document.getElementById('resultCelebrationIcon').textContent = '🎲';
        document.getElementById('resultCelebrationTitle').textContent = 'BET RESULT';
        document.getElementById('resultCelebrationTitle').className = 'text-xl sm:text-2xl font-black text-slate-200';
        document.getElementById('resultCelebrationSummary').textContent = `Winning symbols: ${winningSymbolsList.join(', ')}`;
        document.getElementById('resultCelebrationPayout').innerHTML = `<span class="text-sm font-semibold text-slate-400">Better luck next roll!</span>`;
        document.getElementById('resultCelebrationBanner').classList.remove('hidden');
      }

      roundHistory.unshift({
        round: roundCount,
        dice: [...currentDiceResult],
        winners: Object.keys(counts).filter(k => counts[k] > 0)
      });
      if (roundHistory.length > 20) roundHistory.pop();

      previousBets = { ...currentBets };
      currentBets = { flag: 0, crown: 0, diamond: 0, heart: 0, club: 0, spade: 0 };

      renderRoadmapAndStats();
      saveUserState();
      updateUI();

      setTimeout(() => {
        roundCount++;
        document.getElementById('roundNumberBadge').textContent = `#LK-${roundCount}`;
        startBettingPhase();
      }, 6000);
    }

    function runTimerTick() {
      if (adminTimerPaused) return;

      // 6 PLAYERS MANDATORY CHECK
      const currentTable = TABLES_CONFIG.find(t => t.id === currentTableId) || TABLES_CONFIG[0];
      const seatedCount = currentTable.seated.filter(s => s && s.name).length;

      if (seatedCount < 6) {
        // Paused waiting for 6 players
        timerValue = 15;
        document.getElementById('timerSecondsText').textContent = 'WAIT';
        document.getElementById('phaseTitle').textContent = 'Waiting for 6 Players';
        document.getElementById('phaseSubtitle').textContent = 'Exactly 6 seated players are mandatory to roll the dice.';
        document.getElementById('phaseBadge').textContent = 'PAUSED';
        document.getElementById('phaseBadge').className = 'text-amber-400 font-bold uppercase text-[11px] tracking-wide animate-pulse';
        return;
      }

      if (currentPhase === 'BETTING') {
        timerValue--;
        if (timerValue < 0) {
          timerValue = 0;
          startRollingPhase();
        }
      }

      const timerText = document.getElementById('timerSecondsText');
      const timerProgress = document.getElementById('timerCircleProgress');
      timerText.textContent = timerValue;
      const progressPercent = (timerValue / 15) * 100;
      timerProgress.setAttribute('stroke-dasharray', `${progressPercent}, 100`);

      if (timerValue <= 3 && currentPhase === 'BETTING') {
        timerText.classList.add('text-red-400', 'animate-pulse');
        timerProgress.classList.remove('text-amber-500');
        timerProgress.classList.add('text-red-500');
      } else {
        timerText.classList.remove('text-red-400', 'animate-pulse');
        timerProgress.classList.remove('text-red-500');
        timerProgress.classList.add('text-amber-500');
      }

      // Sync Admin View
      const adminPhaseEl = document.getElementById('adminEnginePhaseText');
      if (adminPhaseEl) {
        adminPhaseEl.textContent = `${currentPhase === 'BETTING' ? 'BETTING OPEN (' + timerValue + 's)' : (currentPhase === 'ROLLING' ? 'ROLLING 6 DICE' : 'PAYOUTS & RESULTS')}`;
      }
      const adminPoolEl = document.getElementById('adminActiveStakesText');
      if (adminPoolEl) adminPoolEl.textContent = roomPool.toLocaleString('en-IN');
    }

