        return;
      }

      if (!isUserSeated) {
        showToast('Please take a seat at the table first to place bets!', 'warning');
        return;
      }

      if (currentPhase !== 'BETTING') {
        showToast('Betting is closed for this round! Wait for next roll.', 'warning');
        return;
      }

      if (currentUser.balance < selectedChip) {
        showToast('Insufficient balance! Please recharge your wallet.', 'error');
        openModal('rechargeModal');
        return;
      }

      currentUser.balance -= selectedChip;
      currentBets[symbolId] += selectedChip;
      roomPool += selectedChip;

      playSound('chip');
      updateUI();
      saveUserState();

      const symbolObj = SYMBOLS.find(s => s.id === symbolId);
      showToast(`Placed ₹${selectedChip} on ${symbolObj.icon} ${symbolObj.name}`, 'info');
    }

