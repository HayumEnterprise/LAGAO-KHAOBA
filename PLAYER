      document.getElementById('profileDistrictBadge').textContent = currentUser.district;
      document.getElementById('statsRoundsPlayed').textContent = currentUser.roundsPlayed;
      
      const winRate = currentUser.roundsPlayed > 0 ? Math.round((currentUser.roundsWon / currentUser.roundsPlayed) * 100) : 0;
      document.getElementById('statsRoundsWon').textContent = `${currentUser.roundsWon} (${winRate}%)`;
      document.getElementById('statsTotalWagered').textContent = `₹${currentUser.totalWagered.toLocaleString('en-IN')}`;
      
      const netProfit = currentUser.totalWon - currentUser.totalWagered;
      const profitEl = document.getElementById('statsNetProfit');
      profitEl.textContent = `${netProfit >= 0 ? '+' : ''}₹${netProfit.toLocaleString('en-IN')}`;
      profitEl.className = `text-base font-bold ${netProfit >= 0 ? 'text-emerald-400' : 'text-red-400'}`;

      const passbookBalEl = document.getElementById('passbookBalance');
      if (passbookBalEl) passbookBalEl.textContent = currentUser.balance.toLocaleString('en-IN');
      const withdrawModalBalEl = document.getElementById('withdrawModalBalance');
      if (withdrawModalBalEl) withdrawModalBalEl.textContent = currentUser.balance.toLocaleString('en-IN');

      renderTableSeatingRoster();
    }

    function renderRoadmapAndStats() {
      const roadmapGrid = document.getElementById('roadmapHistoryGrid');
      roadmapGrid.innerHTML = '';

      roundHistory.forEach(r => {
        const item = document.createElement('div');
        item.className = 'bg-slate-950 border border-slate-800 rounded-xl p-2 min-w-[110px] shrink-0 text-center shadow';
        
        const counts = {};
        r.dice.forEach(d => counts[d] = (counts[d] || 0) + 1);
        const topSymbolId = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
        const topSymbol = SYMBOLS.find(s => s.id === topSymbolId) || SYMBOLS[0];

        item.innerHTML = `
          <div class="text-[9px] text-slate-500 font-mono">#${r.round}</div>
          <div class="text-xl my-1">${topSymbol.icon}</div>
          <div class="text-[10px] font-bold text-amber-400">${topSymbol.name} (${counts[topSymbolId]}x)</div>
          <div class="flex justify-center gap-0.5 mt-1">
            ${r.dice.map(d => {
              const s = SYMBOLS.find(sym => sym.id === d);
              return `<span class="text-[10px]">${s ? s.icon : '🎲'}</span>`;
            }).join('')}
          </div>
        `;
        roadmapGrid.appendChild(item);
      });

      const statsBars = document.getElementById('symbolStatsBars');
      statsBars.innerHTML = '';

      const totalDiceRolled = roundHistory.reduce((acc, curr) => acc + curr.dice.length, 0) || 1;
      const freq = {};
      SYMBOLS.forEach(s => freq[s.id] = 0);
      roundHistory.forEach(r => r.dice.forEach(d => freq[d] = (freq[d] || 0) + 1));

      SYMBOLS.forEach(sym => {
        const count = freq[sym.id] || 0;
        const pct = Math.round((count / totalDiceRolled) * 100);

        const card = document.createElement('div');
        card.className = 'bg-slate-950 p-2.5 rounded-xl border border-slate-800 text-xs';
        card.innerHTML = `
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-bold flex items-center gap-1">${sym.icon} ${sym.name}</span>
            <span class="text-[11px] font-mono text-amber-400 font-semibold">${pct}%</span>
          </div>
          <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full bg-amber-500 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
          </div>
          <div class="text-[10px] text-slate-500 mt-1 flex justify-between">
            <span>Hits: ${count}</span>
            <span>${pct >= 20 ? '🔥 Hot' : '❄️ Cold'}</span>
          </div>
        `;
        statsBars.appendChild(card);
      });
    }

